{
  "$defs": {
    "FactSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable id; the UI's labels and the run's facts key on it",
          "pattern": "^[a-z][a-z0-9_]{0,49}$",
          "title": "Id",
          "type": "string"
        },
        "ask": {
          "description": "What the fact is, in the words the model gets (English)",
          "maxLength": 500,
          "minLength": 1,
          "title": "Ask",
          "type": "string"
        },
        "kind": {
          "default": "text",
          "description": "text, amount, date or number: decides which checks apply; list (format 3): several entries",
          "enum": [
            "text",
            "amount",
            "date",
            "number",
            "list"
          ],
          "title": "Kind",
          "type": "string"
        },
        "of": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/FieldSpec"
              },
              "type": "array"
            },
            {
              "enum": [
                "text",
                "amount",
                "date",
                "number"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "list only: the entries' fields (a record each), or the kind of each entry's one value",
          "title": "Of"
        }
      },
      "required": [
        "id",
        "ask"
      ],
      "title": "FactSpec",
      "type": "object"
    },
    "FieldSpec": {
      "additionalProperties": false,
      "description": "One field of a list's entries (format 3): a plain-valued fact inside the record.",
      "properties": {
        "id": {
          "description": "Stable within the list; labelled as <list id>.<field id>",
          "pattern": "^[a-z][a-z0-9_]{0,49}$",
          "title": "Id",
          "type": "string"
        },
        "ask": {
          "description": "What the field is, in the words the model gets (English)",
          "maxLength": 500,
          "minLength": 1,
          "title": "Ask",
          "type": "string"
        },
        "kind": {
          "default": "text",
          "description": "text, amount, date or number: decides which checks apply",
          "enum": [
            "text",
            "amount",
            "date",
            "number"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "ask"
      ],
      "title": "FieldSpec",
      "type": "object"
    },
    "StepSpec": {
      "additionalProperties": false,
      "description": "One step as written (format 2). Which fields apply depends on ``kind``; the others are refused.",
      "properties": {
        "id": {
          "description": "Stable within the playbook; the run records progress by it",
          "pattern": "^[a-z][a-z0-9_-]{0,49}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "request",
            "read",
            "ask",
            "checkpoint",
            "produce"
          ],
          "title": "Kind",
          "type": "string"
        },
        "needs": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Steps done before this one; default: the previous step",
          "title": "Needs"
        },
        "facts": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "const": "all",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "read, ask: which facts; \"all\" for every fact",
          "title": "Facts"
        },
        "min": {
          "anyOf": [
            {
              "maximum": 50,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "request: uploaded documents needed (default 1)",
          "title": "Min"
        },
        "allow_none": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "request: a person may answer that there is no such document",
          "title": "Allow None"
        },
        "expects": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,49}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "request: a name for what is asked, so a read can aim at it",
          "title": "Expects"
        },
        "documents": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "read: the names (expects) of the requests whose documents it reads; absent: every document",
          "title": "Documents"
        },
        "by": {
          "anyOf": [
            {
              "const": "anyone_in_case",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "checkpoint: who may pass it",
          "title": "By"
        },
        "template": {
          "anyOf": [
            {
              "const": "summary",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "produce: the product (only the summary today)",
          "title": "Template"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "StepSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A playbook as a file: identity, case types, facts, instructions and, in format 2, the routine's steps.",
  "properties": {
    "manifest": {
      "description": "The manifest format's version: 2 (facts, instructions and steps) or 3 (number and list facts too)",
      "enum": [
        2,
        3
      ],
      "title": "Manifest",
      "type": "integer"
    },
    "id": {
      "description": "playbook/<pack>/<name>; never changes once published",
      "pattern": "^playbook/[a-z0-9-]+/[a-z0-9-]+$",
      "title": "Id",
      "type": "string"
    },
    "pack": {
      "description": "pack/<profession-jurisdiction>",
      "pattern": "^pack/[a-z0-9-]+$",
      "title": "Pack",
      "type": "string"
    },
    "version": {
      "description": "major.minor, separate from the id",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$",
      "title": "Version",
      "type": "string"
    },
    "name": {
      "description": "In English: the stored result's file name",
      "maxLength": 80,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "case_types": {
      "description": "Which case types the playbook fits",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Case Types",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/FactSpec"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Facts",
      "type": "array"
    },
    "instructions": {
      "description": "What the model is told, before the table",
      "maxLength": 4000,
      "minLength": 1,
      "title": "Instructions",
      "type": "string"
    },
    "steps": {
      "description": "The routine",
      "items": {
        "$ref": "#/$defs/StepSpec"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "manifest",
    "id",
    "pack",
    "version",
    "name",
    "case_types",
    "facts",
    "instructions",
    "steps"
  ],
  "title": "Sūveryn playbook manifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suveryn.com/schema/playbook-manifest.json"
}
