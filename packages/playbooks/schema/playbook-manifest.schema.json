{
  "$defs": {
    "FactSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable id; the UI's labels and the run's facts key on it",
          "pattern": "^[a-z][a-z0-9_]{0,49}$",
          "title": "Id",
          "type": "string"
        },
        "ask": {
          "description": "What the fact is, in the words the model gets (English)",
          "maxLength": 500,
          "minLength": 1,
          "title": "Ask",
          "type": "string"
        },
        "kind": {
          "default": "text",
          "description": "text, amount or date: decides which checks apply",
          "enum": [
            "text",
            "amount",
            "date"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "ask"
      ],
      "title": "FactSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A playbook as a file: identity, case types, facts and instructions (manifest format 1).",
  "properties": {
    "manifest": {
      "const": 1,
      "description": "The manifest format's version; this file describes format 1",
      "title": "Manifest",
      "type": "integer"
    },
    "id": {
      "description": "playbook/<pack>/<name>; never changes once published",
      "pattern": "^playbook/[a-z0-9-]+/[a-z0-9-]+$",
      "title": "Id",
      "type": "string"
    },
    "pack": {
      "description": "pack/<profession-jurisdiction>",
      "pattern": "^pack/[a-z0-9-]+$",
      "title": "Pack",
      "type": "string"
    },
    "version": {
      "description": "major.minor, separate from the id",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$",
      "title": "Version",
      "type": "string"
    },
    "name": {
      "description": "In English: the stored result's file name",
      "maxLength": 80,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "case_types": {
      "description": "Which case types the playbook fits",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Case Types",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/FactSpec"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Facts",
      "type": "array"
    },
    "instructions": {
      "description": "What the model is told, before the table",
      "maxLength": 4000,
      "minLength": 1,
      "title": "Instructions",
      "type": "string"
    }
  },
  "required": [
    "manifest",
    "id",
    "pack",
    "version",
    "name",
    "case_types",
    "facts",
    "instructions"
  ],
  "title": "Sūveryn playbook manifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suveryn.com/schema/playbook-manifest-1.json"
}
