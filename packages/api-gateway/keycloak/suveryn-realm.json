{
  "realm": "suveryn",
  "displayName": "sūveryn",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "eventsEnabled": true,
  "eventsExpiration": 15552000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "attributes": {"adminEventsExpiration": "15552000"},
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "nl", "fr"],
  "defaultLocale": "en",
  "roles": {
    "realm": [
      {
        "name": "suveryn-admin",
        "description": "Sūveryn administrator: Administration in the chat UI, including the office's accounts (users, their sign-ins)",
        "composite": true,
        "composites": { "client": { "realm-management": ["manage-users", "view-users", "view-realm", "view-events"] } }
      }
    ]
  },
  "scopeMappings": [
    { "client": "suveryn-chat", "roles": ["suveryn-admin"] }
  ],
  "identityProviders": [],
  "identityProviderMappers": [],
  "clients": [
    {
      "clientId": "suveryn-chat",
      "name": "Sūveryn chat",
      "description": "The sūveryn API gateway (confidential client; authorization code flow with PKCE)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "baseUrl": "http://localhost:5173/",
      "redirectUris": ["http://localhost:5173/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      }
    },
    {
      "clientId": "suveryn-directory",
      "name": "Sūveryn directory",
      "description": "The gateway's read-only view of the office's accounts, to add colleagues to a case (suveryn-tracker#10) and to know who administers (the avatar's badge): a service account with view-users and view-realm, both read-only, no sign-in flow",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      }
    }
  ],
  "clientScopeMappings": {
    "realm-management": [{ "client": "suveryn-directory", "roles": ["view-users", "view-realm"] }]
  },
  "users": [
    {
      "username": "service-account-suveryn-directory",
      "enabled": true,
      "serviceAccountClientId": "suveryn-directory",
      "clientRoles": { "realm-management": ["view-users", "view-realm"] }
    }
  ]
}
